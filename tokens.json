{
  "$description": "Runpoint design tokens. One source for color, type, space, layout and motion. Values follow the live site (src/app/v4.css). Edit here, then run `npm run design:build` to rebuild design/tokens.css and design/index.html.",
  "color": {
    "paper": {
      "value": "#FAFAF7",
      "role": "Page background"
    },
    "mist": {
      "value": "#F1F0EC",
      "role": "Alternate light band"
    },
    "line": {
      "value": "#E3E1DA",
      "role": "Rules and borders"
    },
    "line-strong": {
      "value": "#CDC9BF",
      "role": "Borders that must show, quiet tags"
    },
    "ink": {
      "value": "#141311",
      "role": "Headlines and primary text"
    },
    "ink-2": {
      "value": "#46433D",
      "role": "Body copy"
    },
    "muted": {
      "value": "#77736B",
      "role": "Captions, notes, small text"
    },
    "night": {
      "value": "#161411",
      "role": "Dark band, footer, dark button"
    },
    "night-2": {
      "value": "#211E1A",
      "role": "Panels on the dark band"
    },
    "night-line": {
      "value": "#34302A",
      "role": "Rules on the dark band"
    },
    "night-ink": {
      "value": "#F4F1EA",
      "role": "Headlines on the dark band"
    },
    "night-body": {
      "value": "#CDC7BC",
      "role": "Body copy on the dark band"
    },
    "night-muted": {
      "value": "#A39D92",
      "role": "Small text on the dark band"
    },
    "orange": {
      "value": "#FF4400",
      "role": "The one accent. One orange mark per view"
    },
    "orange-deep": {
      "value": "#E03B00",
      "role": "Orange button hover"
    },
    "peach": {
      "value": "#FFE4D4",
      "role": "Light button hover, panel behind product screens"
    },
    "white": {
      "value": "#FFFFFF",
      "role": "Text on orange and night buttons"
    },
    "error": {
      "value": "#B42318",
      "role": "Form errors only"
    },
    "success": {
      "value": "#1D7A45",
      "role": "Confirmations and positive change in charts"
    }
  },
  "duotone": {
    "$description": "Two-color photo treatments (Duo in src/components/v4). Highlight and shadow.",
    "night": {
      "hi": "#E9E3D8",
      "lo": "#1B1612"
    },
    "ember": {
      "hi": "#FF8A52",
      "lo": "#2A0D02"
    },
    "dusk": {
      "hi": "#F6C3A6",
      "lo": "#221A15"
    }
  },
  "retired": {
    "$description": "Colors found in the code that should move to a token.",
    "#FDFDFB": "paper",
    "#1A1A1A": "ink",
    "#1B1B1B": "ink",
    "#1A1917": "ink",
    "#FF4200": "orange",
    "#14120F": "night",
    "#F8F4EA": "mist",
    "#F3F0E8": "mist",
    "#F2F0E9": "mist",
    "#F5F1E8": "mist",
    "#E3DED3": "line",
    "#CFC8B8": "line-strong",
    "#D8D1C5": "line-strong",
    "#726D63": "muted",
    "#6D6A63": "muted",
    "#77736A": "muted",
    "#948F84": "muted",
    "#9A968D": "muted",
    "#777777": "muted",
    "#55524B": "ink-2",
    "#57554E": "ink-2",
    "#626262": "ink-2",
    "#FFE6CF": "peach",
    "#E8E6DD": "line",
    "#E5E2D9": "line",
    "#DCD9D0": "line-strong",
    "#FAF8F3": "paper",
    "#FCFBF7": "paper",
    "#FFFEFA": "paper",
    "#FFFEF9": "paper",
    "#E6E0D5": "night-body",
    "#6D6B64": "muted",
    "#8A887F": "muted",
    "#FF6600": "orange",
    "#F7F4EC": "night-ink",
    "#111111": "night",
    "#F5F3EC": "night-ink"
  },
  "font": {
    "serif": {
      "value": "Newsreader, Georgia, 'Times New Roman', serif",
      "role": "Headlines, big numbers, quotes"
    },
    "sans": {
      "value": "'Hanken Grotesk', 'Helvetica Neue', Arial, sans-serif",
      "role": "Everything else, including navigation"
    },
    "mono": {
      "value": "'Geist Mono', ui-monospace, Menlo, monospace",
      "role": "Small uppercase labels and tags only"
    }
  },
  "type": {
    "display": {
      "family": "serif",
      "size": "clamp(46px, 6.4vw, 98px)",
      "line": "0.98",
      "weight": 500,
      "tracking": "-0.022em",
      "use": "The page's h1"
    },
    "h2": {
      "family": "serif",
      "size": "clamp(34px, 3.9vw, 60px)",
      "line": "1.04",
      "weight": 500,
      "tracking": "-0.018em",
      "use": "Section headline"
    },
    "h3": {
      "family": "serif",
      "size": "clamp(27px, 2.4vw, 36px)",
      "line": "1.08",
      "weight": 500,
      "tracking": "-0.012em",
      "use": "Panel or card title"
    },
    "h4": {
      "family": "sans",
      "size": "clamp(19px, 1.45vw, 22px)",
      "line": "1.18",
      "weight": 600,
      "tracking": "-0.012em",
      "use": "Small card title"
    },
    "lead": {
      "family": "sans",
      "size": "clamp(17px, 1.3vw, 19px)",
      "line": "1.5",
      "weight": 400,
      "tracking": "-0.008em",
      "use": "One sentence under a headline"
    },
    "body": {
      "family": "sans",
      "size": "15px",
      "line": "1.6",
      "weight": 400,
      "tracking": "0",
      "use": "Supporting copy"
    },
    "ui": {
      "family": "sans",
      "size": "14px",
      "line": "1.4",
      "weight": 500,
      "tracking": "-0.01em",
      "use": "Buttons, links, form fields"
    },
    "small": {
      "family": "sans",
      "size": "13px",
      "line": "1.5",
      "weight": 400,
      "tracking": "0",
      "use": "Notes, captions"
    },
    "nav": {
      "family": "sans",
      "size": "12.5px",
      "line": "1",
      "weight": 500,
      "tracking": "0.1em",
      "case": "uppercase",
      "use": "Header navigation"
    },
    "mono": {
      "family": "mono",
      "size": "11.5px",
      "line": "1.3",
      "weight": 400,
      "tracking": "0.06em",
      "case": "uppercase",
      "use": "Labels and tags"
    },
    "stat": {
      "family": "serif",
      "size": "clamp(46px, 4.6vw, 72px)",
      "line": "0.96",
      "weight": 500,
      "tracking": "-0.025em",
      "use": "A big real number"
    },
    "num": {
      "family": "serif",
      "size": "clamp(38px, 3.2vw, 50px)",
      "line": "1",
      "weight": 500,
      "tracking": "-0.02em",
      "color": "orange",
      "use": ".01 style step numbers"
    },
    "quote": {
      "family": "serif",
      "size": "clamp(27px, 3.1vw, 46px)",
      "line": "1.14",
      "weight": 400,
      "tracking": "-0.012em",
      "use": "Client quotes"
    }
  },
  "space": {
    "$description": "4px steps. Tailwind class number in brackets: p-3 = 12px.",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "24": "96px"
  },
  "layout": {
    "wrap": {
      "value": "1200px",
      "wide": "1360px from 1800px",
      "role": "Content width"
    },
    "read": {
      "value": "860px",
      "role": "Reading column for essays and field notes"
    },
    "gutter": {
      "value": "24px",
      "role": "Side padding"
    },
    "section": {
      "value": "clamp(72px, 9vw, 128px)",
      "role": "Top and bottom padding of a band"
    },
    "gap": {
      "value": "12px",
      "role": "Gap between touching panels and grid columns"
    },
    "header": {
      "value": "64px",
      "role": "Sticky header height"
    },
    "columns": {
      "value": "12",
      "role": "Grid columns"
    },
    "radius": {
      "value": "0",
      "role": "Square corners everywhere"
    }
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "nav": "960px",
    "lg": "1024px",
    "wide": "1800px"
  },
  "motion": {
    "ease": {
      "value": "cubic-bezier(0.16, 1, 0.3, 1)",
      "role": "Everything that moves"
    },
    "micro": {
      "value": "160ms",
      "role": "Hover, focus, arrows"
    },
    "reveal": {
      "value": "350ms",
      "role": "A block arriving"
    },
    "draw": {
      "value": "700ms",
      "role": "A bar, line or mark being drawn"
    },
    "words": {
      "value": "900ms",
      "role": "Headline words rising in"
    }
  },
  "button": {
    "height": "40px",
    "height-lg": "48px",
    "padding": "0 14px 0 16px",
    "gap": "14px",
    "variants": {
      "primary": [
        "orange",
        "white",
        "orange-deep"
      ],
      "dark": [
        "night",
        "white",
        "#000000"
      ],
      "light": [
        "white",
        "ink",
        "peach"
      ],
      "line": [
        "transparent",
        "currentColor",
        "rgba(127,120,110,0.12)"
      ]
    }
  }
}
